<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-800 mb-8">Carrito de Compras</h1>
  
  <% if (cart.length === 0) { %>
    <div class="bg-white rounded-lg shadow-md p-12 text-center">
      <div class="text-6xl mb-4 text-gray-300">
        <i class="fas fa-shopping-cart"></i>
      </div>
      <h2 class="text-2xl font-semibold text-gray-800 mb-2">Tu carrito está vacío</h2>
      <p class="text-gray-600 mb-6">Explora nuestros productos y agrega algunos al carrito</p>
      <a href="/products" class="inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition">
        <i class="fas fa-box mr-2"></i> Ver Productos
      </a>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Cart Items -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
          <!-- Desktop Table -->
          <div class="hidden md:block">
            <table class="w-full">
              <thead class="bg-gray-50 border-b">
                <tr>
                  <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Producto</th>
                  <th class="px-6 py-4 text-center text-sm font-semibold text-gray-700">Precio</th>
                  <th class="px-6 py-4 text-center text-sm font-semibold text-gray-700">Cantidad</th>
                  <th class="px-6 py-4 text-center text-sm font-semibold text-gray-700">Subtotal</th>
                  <th class="px-6 py-4 text-center text-sm font-semibold text-gray-700">Acción</th>
                </tr>
              </thead>
              <tbody class="divide-y">
                <% cart.forEach(item => { %>
                  <tr id="cart-item-<%= item.productId %>">
                    <td class="px-6 py-4">
                      <div class="flex items-center space-x-4">
                        <% if (item.imageUrl) { %>
                          <img 
                            src="<%= item.imageUrl %>" 
                            alt="<%= item.name %>" 
                            class="w-16 h-16 object-cover rounded"
                          >
                        <% } else { %>
                          <div class="w-16 h-16 bg-gray-200 rounded flex items-center justify-center">
                            <span class="text-gray-400 text-xs">Sin imagen</span>
                          </div>
                        <% } %>
                        <div>
                          <a href="/products/<%= item.productId %>" class="font-semibold text-gray-800 hover:text-blue-600">
                            <%= item.name %>
                          </a>
                          <p class="text-sm text-gray-500"><%= item.category %></p>
                          <% if (item.stock < item.quantity) { %>
                            <p class="text-xs text-red-600 mt-1">
                              <i class="fas fa-exclamation-triangle mr-1"></i> Stock insuficiente
                            </p>
                          <% } %>
                        </div>
                      </div>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <span class="font-semibold text-gray-800">$<%= item.price.toFixed(2) %></span>
                    </td>
                    <td class="px-6 py-4">
                      <div class="flex items-center justify-center space-x-2">
                        <button 
                          onclick="updateQuantity('<%= item.productId %>', <%= item.quantity - 1 %>, <%= item.stock %>)"
                          class="w-8 h-8 bg-gray-200 hover:bg-gray-300 rounded transition"
                          <%= item.quantity <= 1 ? 'disabled' : '' %>
                        >
                          -
                        </button>
                        <input 
                          type="number" 
                          id="qty-<%= item.productId %>"
                          value="<%= item.quantity %>" 
                          min="1" 
                          max="<%= item.stock %>"
                          class="w-16 text-center px-2 py-1 border border-gray-300 rounded"
                          onchange="updateQuantity('<%= item.productId %>', this.value, <%= item.stock %>)"
                        >
                        <button 
                          onclick="updateQuantity('<%= item.productId %>', <%= item.quantity + 1 %>, <%= item.stock %>)"
                          class="w-8 h-8 bg-gray-200 hover:bg-gray-300 rounded transition"
                          <%= item.quantity >= item.stock ? 'disabled' : '' %>
                        >
                          +
                        </button>
                      </div>
                      <p class="text-xs text-gray-500 text-center mt-1">Stock: <%= item.stock %></p>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <span class="font-bold text-blue-600">$<%= item.subtotal.toFixed(2) %></span>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <button 
                        onclick="removeFromCart('<%= item.productId %>', '<%= item.name %>')"
                        class="text-red-600 hover:text-red-800 transition"
                        title="Eliminar"
                      >
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          
          <!-- Mobile Cards -->
          <div class="md:hidden divide-y">
            <% cart.forEach(item => { %>
              <div class="p-4" id="cart-item-mobile-<%= item.productId %>">
                <div class="flex space-x-4 mb-4">
                  <% if (item.imageUrl) { %>
                    <img 
                      src="<%= item.imageUrl %>" 
                      alt="<%= item.name %>" 
                      class="w-20 h-20 object-cover rounded"
                    >
                  <% } else { %>
                    <div class="w-20 h-20 bg-gray-200 rounded flex items-center justify-center">
                      <span class="text-gray-400 text-xs">Sin imagen</span>
                    </div>
                  <% } %>
                  <div class="flex-1">
                    <a href="/products/<%= item.productId %>" class="font-semibold text-gray-800 hover:text-blue-600 block">
                      <%= item.name %>
                    </a>
                    <p class="text-sm text-gray-500"><%= item.category %></p>
                    <p class="text-lg font-bold text-blue-600 mt-1">$<%= item.price.toFixed(2) %></p>
                  </div>
                </div>
                
                <div class="flex items-center justify-between">
                  <div class="flex items-center space-x-2">
                    <button 
                      onclick="updateQuantity('<%= item.productId %>', <%= item.quantity - 1 %>, <%= item.stock %>)"
                      class="w-8 h-8 bg-gray-200 hover:bg-gray-300 rounded transition"
                      <%= item.quantity <= 1 ? 'disabled' : '' %>
                    >
                      -
                    </button>
                    <input 
                      type="number" 
                      value="<%= item.quantity %>" 
                      min="1" 
                      max="<%= item.stock %>"
                      class="w-16 text-center px-2 py-1 border border-gray-300 rounded"
                      onchange="updateQuantity('<%= item.productId %>', this.value, <%= item.stock %>)"
                    >
                    <button 
                      onclick="updateQuantity('<%= item.productId %>', <%= item.quantity + 1 %>, <%= item.stock %>)"
                      class="w-8 h-8 bg-gray-200 hover:bg-gray-300 rounded transition"
                      <%= item.quantity >= item.stock ? 'disabled' : '' %>
                    >
                      +
                    </button>
                  </div>
                  
                  <div class="text-right">
                    <p class="text-sm text-gray-500">Subtotal</p>
                    <p class="text-lg font-bold text-blue-600">$<%= item.subtotal.toFixed(2) %></p>
                  </div>
                  
                  <button 
                    onclick="removeFromCart('<%= item.productId %>', '<%= item.name %>')"
                    class="text-red-600 hover:text-red-800 transition ml-2"
                  >
                    <i class="fas fa-trash-alt"></i>
                  </button>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
        
        <div class="mt-4 flex justify-between">
          <a href="/products" class="text-blue-600 hover:underline">
            <i class="fas fa-arrow-left mr-1"></i> Seguir comprando
          </a>
          <button 
            onclick="clearCart()"
            class="text-red-600 hover:text-red-800 transition"
          >
            <i class="fas fa-trash mr-1"></i> Vaciar carrito
          </button>
        </div>
      </div>
      
      <!-- Order Summary -->
      <div class="lg:col-span-1">
        <div class="bg-white rounded-lg shadow-md p-6 sticky top-4">
          <h2 class="text-xl font-bold text-gray-800 mb-4">Resumen del Pedido</h2>
          
          <div class="space-y-3 mb-6">
            <div class="flex justify-between text-gray-600">
              <span>Subtotal</span>
              <span class="font-semibold">$<%= subtotal %></span>
            </div>
            <div class="flex justify-between text-gray-600">
              <span>Envío</span>
              <span class="font-semibold">Gratis</span>
            </div>
            <div class="border-t pt-3 flex justify-between text-lg font-bold text-gray-800">
              <span>Total</span>
              <span class="text-blue-600">$<%= total %></span>
            </div>
          </div>
          
          <% if (user) { %>
            <a 
              href="/checkout" 
              class="block w-full bg-blue-600 hover:bg-blue-700 text-white text-center px-6 py-3 rounded-lg font-semibold transition mb-3"
            >
              <i class="fas fa-credit-card mr-2"></i> Proceder al Pago
            </a>
          <% } else { %>
            <a 
              href="/auth/login?redirect=/checkout" 
              class="block w-full bg-blue-600 hover:bg-blue-700 text-white text-center px-6 py-3 rounded-lg font-semibold transition mb-3"
            >
              <i class="fas fa-sign-in-alt mr-2"></i> Iniciar Sesión para Comprar
            </a>
          <% } %>
          
          <div class="text-center text-sm text-gray-500">
            <p><i class="fas fa-lock mr-1"></i> Pago seguro</p>
            <p class="mt-1"><i class="fas fa-truck mr-1"></i> Envío gratis en compras mayores a $50</p>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script>
async function updateQuantity(productId, quantity, stock) {
  const qty = parseInt(quantity);
  
  if (qty < 1) {
    showWarning('La cantidad debe ser al menos 1');
    return;
  }
  
  if (qty > stock) {
    showWarning(`Stock insuficiente. Solo hay ${stock} unidades disponibles`);
    return;
  }
  
  try {
    showLoading('Actualizando cantidad...');
    
    const response = await fetch(`/cart/${productId}`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ quantity: qty })
    });
    
    const data = await response.json();
    
    hideLoading();
    
    if (data.success) {
      showSuccess('Cantidad actualizada');
      setTimeout(() => window.location.reload(), 800);
    } else {
      showError(data.error || 'Error al actualizar cantidad');
    }
  } catch (error) {
    hideLoading();
    console.error('Error:', error);
    showError('Error al actualizar cantidad');
  }
}

async function removeFromCart(productId, productName) {
  const shouldRemove = await showConfirm(
    'Eliminar producto',
    `¿Estás seguro de eliminar "${productName}" del carrito?`,
    {
      confirmText: 'Eliminar',
      cancelText: 'Cancelar',
      type: 'danger'
    }
  );
  
  if (!shouldRemove) {
    return;
  }
  
  try {
    showLoading('Eliminando producto...');
    
    const response = await fetch(`/cart/${productId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json'
      }
    });
    
    const data = await response.json();
    
    hideLoading();
    
    if (data.success) {
      showSuccess('Producto eliminado del carrito');
      setTimeout(() => window.location.reload(), 800);
    } else {
      showError(data.error || 'Error al eliminar del carrito');
    }
  } catch (error) {
    hideLoading();
    console.error('Error:', error);
    showError('Error al eliminar del carrito');
  }
}

async function clearCart() {
  const shouldClear = await showConfirm(
    'Vaciar carrito',
    '¿Estás seguro de vaciar todo el carrito? Esta acción no se puede deshacer.',
    {
      confirmText: 'Vaciar carrito',
      cancelText: 'Cancelar',
      type: 'danger'
    }
  );
  
  if (!shouldClear) {
    return;
  }
  
  try {
    showLoading('Vaciando carrito...');
    
    const response = await fetch('/cart/clear', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      }
    });
    
    const data = await response.json();
    
    hideLoading();
    
    if (data.success) {
      showSuccess('Carrito vaciado correctamente');
      setTimeout(() => window.location.reload(), 800);
    } else {
      showError(data.error || 'Error al vaciar el carrito');
    }
  } catch (error) {
    hideLoading();
    console.error('Error:', error);
    showError('Error al vaciar el carrito');
  }
}
</script>

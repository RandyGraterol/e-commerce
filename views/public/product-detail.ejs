<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <a href="/products" class="text-blue-600 hover:underline">&larr; Volver a productos</a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
    <!-- Image Gallery -->
    <div>
      <% const mainImage = product.images.find(img => img.isMain) || product.images[0]; %>
      <% if (mainImage) { %>
        <img 
          id="mainImage"
          src="<%= mainImage.imageUrl %>" 
          alt="<%= product.name %>" 
          class="w-full h-96 object-cover rounded-lg shadow-lg mb-4"
        >
      <% } else { %>
        <div class="w-full h-96 bg-gray-200 rounded-lg flex items-center justify-center mb-4">
          <span class="text-gray-400 text-xl">Sin imagen</span>
        </div>
      <% } %>
      
      <!-- Thumbnails -->
      <% if (product.images.length > 1) { %>
        <div class="grid grid-cols-4 gap-2">
          <% product.images.forEach(image => { %>
            <img 
              src="<%= image.imageUrl %>" 
              alt="<%= product.name %>" 
              class="w-full h-20 object-cover rounded cursor-pointer hover:opacity-75 transition <%= image.isMain ? 'ring-2 ring-blue-500' : '' %>"
              onclick="changeMainImage('<%= image.imageUrl %>')"
            >
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- Product Info -->
    <div>
      <h1 class="text-3xl font-bold text-gray-800 mb-4"><%= product.name %></h1>
      
      <div class="mb-4">
        <a href="/products?category=<%= product.category.id %>" class="inline-block px-3 py-1 bg-purple-100 text-purple-800 rounded text-sm hover:bg-purple-200 transition">
          <%= product.category.name %>
        </a>
      </div>
      
      <div class="mb-6">
        <span class="text-4xl font-bold text-blue-600">
          $<%= parseFloat(product.price).toFixed(2) %>
        </span>
      </div>
      
      <% if (product.stock > 0) { %>
        <div class="mb-6">
          <span class="inline-block px-3 py-1 bg-green-100 text-green-800 rounded text-sm">
            ✓ En stock (<%= product.stock %> disponibles)
          </span>
        </div>
      <% } else { %>
        <div class="mb-6">
          <span class="inline-block px-3 py-1 bg-red-100 text-red-800 rounded text-sm">
            ✗ Agotado
          </span>
        </div>
      <% } %>
      
      <% if (product.description) { %>
        <div class="mb-6">
          <h2 class="text-xl font-semibold mb-2">Descripción</h2>
          <p class="text-gray-700 whitespace-pre-line"><%= product.description %></p>
        </div>
      <% } %>
      
      <% if (product.stock > 0) { %>
        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">Cantidad</label>
          <div class="flex items-center space-x-4">
            <button 
              onclick="decrementQuantity()" 
              class="w-10 h-10 bg-gray-200 hover:bg-gray-300 rounded-lg transition"
            >
              -
            </button>
            <input 
              type="number" 
              id="quantity" 
              value="1" 
              min="1" 
              max="<%= product.stock %>"
              class="w-20 text-center px-4 py-2 border border-gray-300 rounded-lg"
            >
            <button 
              onclick="incrementQuantity()" 
              class="w-10 h-10 bg-gray-200 hover:bg-gray-300 rounded-lg transition"
            >
              +
            </button>
          </div>
        </div>
        
        <div class="flex space-x-4">
          <button 
            onclick="addToCart(<%= product.id %>)" 
            class="flex-1 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold transition"
          >
            🛒 Agregar al Carrito
          </button>
          
          <% if (user) { %>
            <button 
              onclick="addToFavorites(<%= product.id %>)" 
              class="px-6 py-3 bg-red-100 hover:bg-red-200 text-red-600 rounded-lg transition"
              title="Agregar a favoritos"
            >
              ❤️
            </button>
          <% } %>
        </div>
      <% } else { %>
        <div class="bg-gray-100 text-gray-600 px-6 py-3 rounded-lg text-center">
          Producto no disponible
        </div>
      <% } %>
    </div>
  </div>

  <!-- Related Products -->
  <% if (relatedProducts.length > 0) { %>
    <div class="mt-16">
      <h2 class="text-2xl font-bold text-gray-800 mb-6">Productos Relacionados</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        <% relatedProducts.forEach(relatedProduct => { %>
          <% const relatedImage = relatedProduct.images.find(img => img.isMain) || relatedProduct.images[0]; %>
          <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition">
            <a href="/products/<%= relatedProduct.id %>">
              <% if (relatedImage) { %>
                <img 
                  src="<%= relatedImage.imageUrl %>" 
                  alt="<%= relatedProduct.name %>" 
                  class="w-full h-48 object-cover"
                >
              <% } else { %>
                <div class="w-full h-48 bg-gray-200 flex items-center justify-center">
                  <span class="text-gray-400">Sin imagen</span>
                </div>
              <% } %>
            </a>
            
            <div class="p-4">
              <a href="/products/<%= relatedProduct.id %>" class="block">
                <h3 class="font-semibold text-gray-800 mb-2 hover:text-blue-600 transition line-clamp-2">
                  <%= relatedProduct.name %>
                </h3>
              </a>
              
              <div class="flex justify-between items-center">
                <span class="text-xl font-bold text-blue-600">
                  $<%= parseFloat(relatedProduct.price).toFixed(2) %>
                </span>
                
                <a 
                  href="/products/<%= relatedProduct.id %>" 
                  class="text-blue-600 hover:text-blue-800 text-sm"
                >
                  Ver →
                </a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>
</div>

<script>
function changeMainImage(imageUrl) {
  document.getElementById('mainImage').src = imageUrl;
}

function incrementQuantity() {
  const input = document.getElementById('quantity');
  const max = parseInt(input.max);
  const current = parseInt(input.value);
  if (current < max) {
    input.value = current + 1;
  }
}

function decrementQuantity() {
  const input = document.getElementById('quantity');
  const current = parseInt(input.value);
  if (current > 1) {
    input.value = current - 1;
  }
}

function addToCart(productId) {
  const quantity = parseInt(document.getElementById('quantity').value);
  
  showLoading('Agregando al carrito...');
  
  fetch('/cart/add', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({ productId, quantity })
  })
  .then(response => response.json())
  .then(async data => {
    hideLoading();
    
    if (data.success) {
      const goToCart = await showConfirm(
        '¡Producto agregado!',
        'El producto se agregó correctamente al carrito. ¿Deseas ir al carrito ahora?',
        {
          confirmText: 'Ir al carrito',
          cancelText: 'Seguir comprando',
          type: 'success'
        }
      );
      
      if (goToCart) {
        window.location.href = '/cart';
      } else {
        showSuccess('Producto agregado al carrito');
      }
    } else {
      showError(data.error || 'Error al agregar al carrito');
    }
  })
  .catch(error => {
    hideLoading();
    console.error('Error:', error);
    showError('Error al agregar al carrito');
  });
}

async function addToFavorites(productId) {
  <% if (!user) { %>
    const shouldLogin = await showConfirm(
      'Iniciar sesión requerido',
      'Debes iniciar sesión para agregar productos a favoritos',
      {
        confirmText: 'Iniciar sesión',
        cancelText: 'Cancelar',
        type: 'info'
      }
    );
    
    if (shouldLogin) {
      window.location.href = '/auth/login';
    }
    return;
  <% } %>
  
  try {
    const response = await fetch('/client/favorites', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ productId })
    });
    
    const data = await response.json();
    
    if (data.success) {
      if (data.alreadyExists) {
        showInfo('Este producto ya está en tus favoritos');
      } else {
        showSuccess('Producto agregado a favoritos ❤️');
      }
    } else {
      showError(data.error || 'Error al agregar a favoritos');
    }
  } catch (error) {
    console.error('Error:', error);
    showError('Error al agregar a favoritos');
  }
}
</script>

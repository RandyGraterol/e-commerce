<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-800 mb-8">Productos</h1>
  
  <div class="flex flex-col md:flex-row gap-8">
    <!-- Sidebar Filters -->
    <aside class="w-full md:w-64 flex-shrink-0">
      <div class="bg-white rounded-lg shadow-md p-6 sticky top-4">
        <h2 class="text-xl font-semibold mb-4">Filtros</h2>
        
        <form method="GET" action="/products">
          <!-- Search -->
          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-2">Buscar</label>
            <input 
              type="text" 
              name="search" 
              value="<%= search %>" 
              placeholder="Buscar productos..."
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            >
          </div>
          
          <!-- Category Filter -->
          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-2">Categoría</label>
            <select 
              name="category" 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            >
              <option value="">Todas</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>" <%= categoryId == cat.id ? 'selected' : '' %>>
                  <%= cat.name %>
                </option>
              <% }); %>
            </select>
          </div>
          
          <!-- Sort -->
          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-2">Ordenar por</label>
            <select 
              name="sort" 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            >
              <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Más recientes</option>
              <option value="price-asc" <%= sort === 'price-asc' ? 'selected' : '' %>>Precio: Menor a Mayor</option>
              <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>>Precio: Mayor a Menor</option>
              <option value="name" <%= sort === 'name' ? 'selected' : '' %>>Nombre A-Z</option>
            </select>
          </div>
          
          <button 
            type="submit" 
            class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition"
          >
            Aplicar Filtros
          </button>
          
          <% if (search || categoryId || sort !== 'newest') { %>
            <a 
              href="/products" 
              class="block w-full text-center mt-3 text-gray-600 hover:text-gray-800 text-sm"
            >
              Limpiar filtros
            </a>
          <% } %>
        </form>
      </div>
    </aside>
    
    <!-- Products Grid -->
    <div class="flex-1">
      <% if (products.length === 0) { %>
        <div class="bg-white rounded-lg shadow-md p-12 text-center">
          <p class="text-xl text-gray-500 mb-4">No se encontraron productos</p>
          <a href="/products" class="text-blue-600 hover:underline">Ver todos los productos</a>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
          <% products.forEach(product => { %>
            <% const mainImage = product.images.find(img => img.isMain) || product.images[0]; %>
            <div class="product-card group bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 flex flex-col">
              <!-- Image Container -->
              <div class="relative overflow-hidden bg-gray-100">
                <a href="/products/<%= product.id %>" class="block">
                  <% if (mainImage) { %>
                    <img 
                      src="<%= mainImage.imageUrl %>" 
                      alt="<%= product.name %>" 
                      class="w-full h-48 sm:h-56 object-cover group-hover:scale-110 transition-transform duration-500"
                    >
                  <% } else { %>
                    <div class="w-full h-48 sm:h-56 bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center">
                      <i class="fas fa-image text-gray-400 text-4xl"></i>
                    </div>
                  <% } %>
                </a>
                
                <!-- Favorite Button -->
                <% if (user) { %>
                  <button 
                    onclick="addToFavorites(<%= product.id %>)"
                    class="absolute top-3 right-3 bg-white hover:bg-red-50 text-red-500 w-9 h-9 rounded-full shadow-lg flex items-center justify-center transition-all duration-200 hover:scale-110"
                    title="Agregar a favoritos"
                  >
                    <i class="fas fa-heart"></i>
                  </button>
                <% } %>
                
                <!-- Stock Badge -->
                <div class="absolute bottom-3 left-3">
                  <% if (product.stock > 0) { %>
                    <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-semibold shadow-md flex items-center">
                      <i class="fas fa-check-circle mr-1"></i> Stock: <%= product.stock %>
                    </span>
                  <% } else { %>
                    <span class="bg-red-500 text-white px-3 py-1 rounded-full text-xs font-semibold shadow-md flex items-center">
                      <i class="fas fa-times-circle mr-1"></i> Agotado
                    </span>
                  <% } %>
                </div>
              </div>
              
              <!-- Content -->
              <div class="p-4 sm:p-5 flex flex-col flex-grow">
                <!-- Category -->
                <div class="flex items-center text-xs sm:text-sm text-gray-500 mb-2">
                  <i class="fas fa-tag mr-1.5 text-blue-500"></i>
                  <span class="truncate"><%= product.category.name %></span>
                </div>
                
                <!-- Title -->
                <a href="/products/<%= product.id %>" class="block mb-3">
                  <h3 class="font-bold text-gray-800 text-base sm:text-lg leading-tight group-hover:text-blue-600 transition line-clamp-2 min-h-[2.5rem] sm:min-h-[3rem]">
                    <%= product.name %>
                  </h3>
                </a>
                
                <!-- Price -->
                <div class="mb-4 mt-auto">
                  <div class="flex items-baseline gap-2">
                    <span class="text-2xl sm:text-3xl font-bold text-blue-600">
                      $<%= parseFloat(product.price).toFixed(2) %>
                    </span>
                  </div>
                  <p class="text-xs text-green-600 font-medium mt-1">
                    <i class="fas fa-truck mr-1"></i> Envío gratis
                  </p>
                </div>
                
                <!-- Actions -->
                <div class="flex gap-2">
                  <% if (product.stock > 0) { %>
                    <button 
                      onclick="quickAddToCart('<%= product.id %>')"
                      class="flex-1 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white px-3 sm:px-4 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-lg flex items-center justify-center"
                      title="Agregar al carrito"
                    >
                      <i class="fas fa-cart-plus mr-1.5"></i>
                      <span class="hidden sm:inline">Agregar</span>
                      <span class="sm:hidden">+</span>
                    </button>
                  <% } else { %>
                    <button 
                      disabled
                      class="flex-1 bg-gray-300 text-gray-500 px-3 sm:px-4 py-2.5 rounded-lg text-xs sm:text-sm font-semibold cursor-not-allowed"
                    >
                      <i class="fas fa-ban mr-1.5"></i> Agotado
                    </button>
                  <% } %>
                  
                  <a 
                    href="/products/<%= product.id %>" 
                    class="bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white px-3 sm:px-4 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-lg flex items-center justify-center"
                  >
                    <i class="fas fa-eye"></i>
                    <span class="hidden sm:inline ml-1.5">Ver</span>
                  </a>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
        
        <style>
          .product-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
          }
          
          .product-card:hover {
            transform: translateY(-8px);
          }
          
          .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
          }
        </style>
        
        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <div class="mt-8 flex justify-center items-center space-x-2">
            <% if (currentPage > 1) { %>
              <a 
                href="?page=<%= currentPage - 1 %><%= search ? '&search=' + search : '' %><%= categoryId ? '&category=' + categoryId : '' %><%= sort ? '&sort=' + sort : '' %>" 
                class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50"
              >
                Anterior
              </a>
            <% } %>
            
            <% for (let i = 1; i <= totalPages; i++) { %>
              <% if (i === currentPage) { %>
                <span class="px-4 py-2 bg-blue-600 text-white rounded-lg">
                  <%= i %>
                </span>
              <% } else if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
                <a 
                  href="?page=<%= i %><%= search ? '&search=' + search : '' %><%= categoryId ? '&category=' + categoryId : '' %><%= sort ? '&sort=' + sort : '' %>" 
                  class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50"
                >
                  <%= i %>
                </a>
              <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
                <span class="px-2">...</span>
              <% } %>
            <% } %>
            
            <% if (currentPage < totalPages) { %>
              <a 
                href="?page=<%= currentPage + 1 %><%= search ? '&search=' + search : '' %><%= categoryId ? '&category=' + categoryId : '' %><%= sort ? '&sort=' + sort : '' %>" 
                class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50"
              >
                Siguiente
              </a>
            <% } %>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<script>
async function quickAddToCart(productId) {
  try {
    const response = await fetch('/cart/add', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ productId, quantity: 1 })
    });
    
    const data = await response.json();
    
    if (data.success) {
      const goToCart = await showConfirm(
        '¡Producto agregado!',
        'El producto se agregó correctamente al carrito. ¿Deseas ir al carrito ahora?',
        {
          confirmText: 'Ir al carrito',
          cancelText: 'Seguir comprando',
          type: 'success'
        }
      );
      
      if (goToCart) {
        window.location.href = '/cart';
      } else {
        showSuccess('Producto agregado al carrito');
      }
    } else {
      showError(data.error || 'Error al agregar al carrito');
    }
  } catch (error) {
    console.error('Error:', error);
    showError('Error al agregar al carrito');
  }
}

async function addToFavorites(productId) {
  <% if (!user) { %>
    const shouldLogin = await showConfirm(
      'Iniciar sesión requerido',
      'Debes iniciar sesión para agregar productos a favoritos',
      {
        confirmText: 'Iniciar sesión',
        cancelText: 'Cancelar',
        type: 'info'
      }
    );
    
    if (shouldLogin) {
      window.location.href = '/auth/login';
    }
    return;
  <% } %>
  
  try {
    const response = await fetch('/client/favorites', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ productId })
    });
    
    const data = await response.json();
    
    if (data.success) {
      if (data.alreadyExists) {
        showInfo('Este producto ya está en tus favoritos');
      } else {
        showSuccess('Producto agregado a favoritos ❤️');
      }
    } else {
      showError(data.error || 'Error al agregar a favoritos');
    }
  } catch (error) {
    console.error('Error:', error);
    showError('Error al agregar a favoritos');
  }
}
</script>

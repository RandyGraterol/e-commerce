<style>
  /* Full Screen Hero Banner - 100vw x 100vh */
  .hero-banner-fullscreen {
    position: relative;
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: 0;
    overflow: hidden;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }
  
  .hero-slider {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
  }
  
  .hero-slide {
    display: none;
    position: relative;
    width: 100%;
    height: 100%;
    animation: fadeIn 0.8s ease-in-out;
    margin: 0;
    padding: 0;
  }
  
  .hero-slide.active {
    display: block;
  }
  
  .hero-image-container {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }
  
  .hero-image-container picture {
    width: 100%;
    height: 100%;
    display: block;
    margin: 0;
    padding: 0;
  }
  
  .hero-background-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    margin: 0;
    padding: 0;
  }
  
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.7) 0%, rgba(118, 75, 162, 0.7) 100%);
    z-index: 1;
    margin: 0;
    padding: 0;
  }
  
  .hero-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out;
  }
  
  .animate-fade-in-up-delay {
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .slider-dot.active {
    opacity: 1;
    transform: scale(1.2);
  }
</style>

<!-- Categories Section -->
<div class="container mx-auto px-4 py-12 md:py-16 lg:py-20">
  <div class="text-center mb-10 md:mb-12">
    <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-3">
      <i class="fas fa-th-large text-blue-600 mr-2"></i>
      Explora por Categorías
    </h2>
    <p class="text-gray-600 text-lg">Encuentra exactamente lo que buscas</p>
  </div>
  
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
    <% categories.forEach(category => { %>
      <a href="/products?category=<%= category.id %>" class="group bg-white rounded-xl shadow-md hover:shadow-2xl transition-all duration-300 p-6 text-center transform hover:-translate-y-2">
        <div class="text-4xl md:text-5xl mb-3 group-hover:scale-110 transition-transform duration-300">
          <% 
            const icons = {
              'electronica': 'fa-laptop',
              'ropa': 'fa-shirt',
              'hogar': 'fa-house',
              'deportes': 'fa-futbol',
              'libros': 'fa-book',
              'juguetes': 'fa-puzzle-piece'
            };
            const iconClass = icons[category.slug] || 'fa-box';
          %>
          <i class="fas <%= iconClass %> text-blue-600"></i>
        </div>
        <h3 class="font-semibold text-gray-800 group-hover:text-blue-600 transition text-sm md:text-base">
          <%= category.name %>
        </h3>
      </a>
    <% }); %>
  </div>
</div>

<!-- Featured Products Section -->
<div class="bg-gradient-to-br from-gray-50 to-blue-50 py-12 md:py-16 lg:py-20">

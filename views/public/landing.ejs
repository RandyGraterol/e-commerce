    <i class="fas fa-chevron-left text-sm md:text-base"></i>
  </button>
  <button onclick="nextSlide()" class="absolute right-2 md:right-4 top-1/2 transform -translate-y-1/2 bg-white bg-opacity-30 hover:bg-opacity-50 text-white p-2 md:p-3 rounded-full transition z-20">
    <i class="fas fa-chevron-right text-sm md:text-base"></i>
  </button>

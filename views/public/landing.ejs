          <source media="(min-width: 768px)" srcset="/assets/headerDesktop.png">
          <img src="/assets/headerMobile.png" alt="Envío Gratis" class="hero-background-image">
        </picture>
        <div class="hero-overlay" style="background: linear-gradient(135deg, rgba(79, 172, 254, 0.7) 0%, rgba(0, 242, 254, 0.7) 100%);"></div>
      </div>
      <div class="hero-content">
        <div class="container mx-auto px-4 md:px-6 lg:px-8">

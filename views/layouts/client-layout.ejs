<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Mi Cuenta' %> - E-commerce</title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  
  <!-- Notifications System -->
  <script src="/js/notifications.js"></script>
</head>
<body class="bg-gray-50">
  <!-- Header -->
  <header class="bg-white shadow-md sticky top-0 z-50">
    <nav class="container mx-auto px-4 py-4">
      <div class="flex justify-between items-center">
        <a href="/" class="text-2xl font-bold text-blue-600">🛒 E-commerce</a>
        
        <div class="hidden md:flex space-x-6">
          <a href="/" class="text-gray-700 hover:text-blue-600 transition">Inicio</a>
          <a href="/products" class="text-gray-700 hover:text-blue-600 transition">Productos</a>
          <a href="/cart" class="text-gray-700 hover:text-blue-600 transition">🛒 Carrito</a>
        </div>
        
        <div class="flex items-center space-x-4">
          <% if (typeof user !== 'undefined' && user) { %>
            <span class="text-gray-700">Hola, <%= user.name %></span>
            <form action="/auth/logout" method="POST" class="inline">
              <button type="submit" class="text-red-600 hover:text-red-800 transition">Salir</button>
            </form>
          <% } %>
        </div>
      </div>
    </nav>
  </header>

  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row gap-6">
      <!-- Sidebar -->
      <aside class="w-full md:w-64 flex-shrink-0">
        <div class="bg-white rounded-lg shadow-md p-6">
          <h2 class="text-xl font-bold text-gray-800 mb-4">Mi Cuenta</h2>
          
          <nav class="space-y-2">
            <a href="/client/profile" class="flex items-center px-4 py-2 text-gray-700 hover:bg-blue-50 hover:text-blue-600 rounded transition">
              <span class="mr-3">👤</span>
              Mi Perfil
            </a>
            <a href="/client/orders" class="flex items-center px-4 py-2 text-gray-700 hover:bg-blue-50 hover:text-blue-600 rounded transition">
              <span class="mr-3">📦</span>
              Mis Pedidos
            </a>
            <a href="/client/favorites" class="flex items-center px-4 py-2 text-gray-700 hover:bg-blue-50 hover:text-blue-600 rounded transition">
              <span class="mr-3">❤️</span>
              Favoritos
            </a>
            <a href="/cart" class="flex items-center px-4 py-2 text-gray-700 hover:bg-blue-50 hover:text-blue-600 rounded transition">
              <span class="mr-3">🛒</span>
              Carrito
            </a>
          </nav>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="flex-1">
        <div class="bg-white rounded-lg shadow-md p-6">
          <%- body %>
        </div>
      </main>
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-gray-800 text-white mt-12">
    <div class="container mx-auto px-4 py-8">
      <div class="text-center">
        <p class="text-gray-400">&copy; 2026 E-commerce Platform. Todos los derechos reservados.</p>
      </div>
    </div>
  </footer>
</body>
</html>

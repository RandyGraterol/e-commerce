<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Admin Panel' %> - E-commerce</title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  
  <!-- Notifications System -->
  <script src="/js/notifications.js"></script>
  
  <style>
    body {
      min-height: 100vh;
    }
  </style>
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <aside class="w-64 bg-gray-800 text-white flex-shrink-0 hidden md:block">
      <div class="p-6">
        <h1 class="text-2xl font-bold">🛠️ Admin Panel</h1>
        <p class="text-gray-400 text-sm mt-1">E-commerce Platform</p>
      </div>
      
      <nav class="mt-6">
        <a href="/admin/dashboard" class="flex items-center px-6 py-3 text-gray-300 hover:bg-gray-700 hover:text-white transition">
          <span class="mr-3">📊</span>
          Dashboard
        </a>
        <a href="/admin/products" class="flex items-center px-6 py-3 text-gray-300 hover:bg-gray-700 hover:text-white transition">
          <span class="mr-3">📦</span>
          Productos
        </a>
        <a href="/admin/categories" class="flex items-center px-6 py-3 text-gray-300 hover:bg-gray-700 hover:text-white transition">
          <span class="mr-3">🏷️</span>
          Categorías
        </a>
        <a href="/admin/orders" class="flex items-center px-6 py-3 text-gray-300 hover:bg-gray-700 hover:text-white transition">
          <span class="mr-3">🛒</span>
          Órdenes
        </a>
        <a href="/admin/users" class="flex items-center px-6 py-3 text-gray-300 hover:bg-gray-700 hover:text-white transition">
          <span class="mr-3">👥</span>
          Usuarios
        </a>
        
        <div class="border-t border-gray-700 mt-6 pt-6">
          <a href="/" class="flex items-center px-6 py-3 text-gray-300 hover:bg-gray-700 hover:text-white transition">
            <span class="mr-3">🏠</span>
            Ver Sitio
          </a>
          <form action="/auth/logout" method="POST">
            <button type="submit" class="w-full flex items-center px-6 py-3 text-gray-300 hover:bg-gray-700 hover:text-white transition text-left">
              <span class="mr-3">🚪</span>
              Cerrar Sesión
            </button>
          </form>
        </div>
      </nav>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col overflow-hidden">
      <!-- Top Header -->
      <header class="bg-white shadow-sm z-10">
        <div class="flex items-center justify-between px-6 py-4">
          <h2 class="text-2xl font-semibold text-gray-800">
            <%= typeof title !== 'undefined' ? title : 'Admin Panel' %>
          </h2>
          
          <div class="flex items-center space-x-4">
            <% if (typeof user !== 'undefined' && user) { %>
              <span class="text-gray-600">👤 <%= user.name %></span>
            <% } %>
          </div>
        </div>
      </header>

      <!-- Main Content -->
      <main class="flex-1 overflow-y-auto p-6">
        <%- body %>
      </main>
    </div>
  </div>
</body>
</html>

<div class="min-h-screen flex items-center justify-center bg-gray-100">
  <div class="max-w-2xl w-full bg-white shadow-lg rounded-lg p-8">
    <div class="text-center mb-6">
      <div class="text-6xl font-bold text-red-600 mb-4">500</div>
      <h1 class="text-3xl font-bold text-gray-800 mb-4">Error del Servidor</h1>
      <p class="text-gray-600 mb-6">
        <%= message || 'Algo salió mal. Por favor, intenta de nuevo más tarde.' %>
      </p>
    </div>
    
    <% if (typeof stack !== 'undefined' && stack) { %>
      <div class="bg-gray-100 p-4 rounded-lg overflow-auto">
        <h3 class="font-bold text-gray-700 mb-2">Stack Trace (Development Mode):</h3>
        <pre class="text-xs text-gray-600 whitespace-pre-wrap"><%= stack %></pre>
      </div>
    <% } %>
    
    <div class="text-center mt-6">
      <a href="/" class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
        Volver al Inicio
      </a>
    </div>
  </div>
</div>

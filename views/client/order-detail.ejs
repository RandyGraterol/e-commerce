<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <a href="/client/orders" class="text-blue-600 hover:underline">&larr; Volver a mis pedidos</a>
  </div>
  
  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Pedido #<%= order.id %></h1>
        <p class="text-gray-600 mt-1">
          Realizado el <%= new Date(order.createdAt).toLocaleDateString('es-ES', { 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          }) %>
        </p>
      </div>
      
      <div>
        <% 
          let statusColor = 'gray';
          let statusText = 'Desconocido';
          let statusIcon = '❓';
          
          if (order.status === 'pending') {
            statusColor = 'yellow';
            statusText = 'Pendiente';
            statusIcon = '⏳';
          } else if (order.status === 'completed') {
            statusColor = 'green';
            statusText = 'Completado';
            statusIcon = '✅';
          } else if (order.status === 'cancelled') {
            statusColor = 'red';
            statusText = 'Cancelado';
            statusIcon = '❌';
          }
        %>
        <span class="inline-block px-4 py-2 bg-<%= statusColor %>-100 text-<%= statusColor %>-800 rounded-lg text-lg font-semibold">
          <%= statusIcon %> <%= statusText %>
        </span>
      </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      <div class="bg-gray-50 rounded-lg p-4">
        <p class="text-sm text-gray-600 mb-1">Total del Pedido</p>
        <p class="text-2xl font-bold text-blue-600">$<%= parseFloat(order.total).toFixed(2) %></p>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-4">
        <p class="text-sm text-gray-600 mb-1">Método de Pago</p>
        <p class="text-lg font-semibold text-gray-800">
          <% if (order.paymentMethod === 'credit_card') { %>
            💳 Tarjeta de Crédito
          <% } else { %>
            <%= order.paymentMethod %>
          <% } %>
        </p>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-4">
        <p class="text-sm text-gray-600 mb-1">Productos</p>
        <p class="text-lg font-semibold text-gray-800">
          <%= order.items.reduce((sum, item) => sum + item.quantity, 0) %> items
        </p>
      </div>
    </div>
    
    <div class="border-t pt-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Dirección de Envío</h2>
      <p class="text-gray-700">
        📍 <%= order.shippingAddress %>
      </p>
    </div>
  </div>
  
  <!-- Order Items -->
  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="px-6 py-4 bg-gray-50 border-b">
      <h2 class="text-xl font-bold text-gray-800">Productos del Pedido</h2>
    </div>
    
    <!-- Desktop Table -->
    <div class="hidden md:block">
      <table class="w-full">
        <thead class="bg-gray-50 border-b">
          <tr>
            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Producto</th>
            <th class="px-6 py-4 text-center text-sm font-semibold text-gray-700">Precio</th>
            <th class="px-6 py-4 text-center text-sm font-semibold text-gray-700">Cantidad</th>
            <th class="px-6 py-4 text-center text-sm font-semibold text-gray-700">Subtotal</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          <% order.items.forEach(item => { %>
            <% 
              let mainImage = null;
              if (item.product && item.product.images && item.product.images.length > 0) {
                mainImage = item.product.images.find(img => img.isMain) || item.product.images[0];
              }
            %>
            <tr>
              <td class="px-6 py-4">
                <div class="flex items-center space-x-4">
                  <% if (mainImage) { %>
                    <img 
                      src="<%= mainImage.imageUrl %>" 
                      alt="<%= item.product.name %>" 
                      class="w-16 h-16 object-cover rounded"
                    >
                  <% } else { %>
                    <div class="w-16 h-16 bg-gray-200 rounded flex items-center justify-center">
                      <span class="text-gray-400 text-xs">📦</span>
                    </div>
                  <% } %>
                  <div>
                    <p class="font-semibold text-gray-800"><%= item.product.name %></p>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 text-center">
                <span class="font-semibold text-gray-800">$<%= parseFloat(item.price).toFixed(2) %></span>
              </td>
              <td class="px-6 py-4 text-center">
                <span class="text-gray-800"><%= item.quantity %></span>
              </td>
              <td class="px-6 py-4 text-center">
                <span class="font-bold text-blue-600">$<%= (parseFloat(item.price) * item.quantity).toFixed(2) %></span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    
    <!-- Mobile Cards -->
    <div class="md:hidden divide-y">
      <% order.items.forEach(item => { %>
        <% 
          let mainImage = null;
          if (item.product && item.product.images && item.product.images.length > 0) {
            mainImage = item.product.images.find(img => img.isMain) || item.product.images[0];
          }
        %>
        <div class="p-4">
          <div class="flex space-x-4 mb-3">
            <% if (mainImage) { %>
              <img 
                src="<%= mainImage.imageUrl %>" 
                alt="<%= item.product.name %>" 
                class="w-20 h-20 object-cover rounded"
              >
            <% } else { %>
              <div class="w-20 h-20 bg-gray-200 rounded flex items-center justify-center">
                <span class="text-gray-400 text-2xl">📦</span>
              </div>
            <% } %>
            <div class="flex-1">
              <p class="font-semibold text-gray-800"><%= item.product.name %></p>
              <p class="text-sm text-gray-600 mt-1">Precio: $<%= parseFloat(item.price).toFixed(2) %></p>
              <p class="text-sm text-gray-600">Cantidad: <%= item.quantity %></p>
            </div>
          </div>
          <div class="flex justify-between items-center pt-3 border-t">
            <span class="text-sm text-gray-600">Subtotal</span>
            <span class="text-lg font-bold text-blue-600">$<%= (parseFloat(item.price) * item.quantity).toFixed(2) %></span>
          </div>
        </div>
      <% }); %>
    </div>
    
    <!-- Total -->
    <div class="px-6 py-4 bg-gray-50 border-t">
      <div class="flex justify-between items-center">
        <span class="text-lg font-semibold text-gray-800">Total del Pedido</span>
        <span class="text-2xl font-bold text-blue-600">$<%= parseFloat(order.total).toFixed(2) %></span>
      </div>
    </div>
  </div>
  
  <div class="mt-8 text-center">
    <a href="/products" class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition">
      Seguir Comprando
    </a>
  </div>
</div>

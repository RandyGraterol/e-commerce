<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-800 mb-8 flex items-center">
    <i class="fas fa-receipt mr-3 text-blue-600"></i>
    Mis Pedidos
  </h1>
  
  <% if (orders.length === 0) { %>
    <div class="bg-white rounded-lg shadow-md p-12 text-center">
      <div class="text-6xl mb-4 text-gray-300">
        <i class="fas fa-box-open"></i>
      </div>
      <h2 class="text-2xl font-semibold text-gray-800 mb-2">No tienes pedidos aún</h2>
      <p class="text-gray-600 mb-6">Explora nuestros productos y realiza tu primera compra</p>
      <a href="/products" class="inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition">
        <i class="fas fa-shopping-bag mr-2"></i>
        Ver Productos
      </a>
    </div>
  <% } else { %>
    <div class="space-y-4">
      <% orders.forEach(order => { %>
        <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
          <div class="p-6">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4">
              <div>
                <h3 class="text-lg font-bold text-gray-800 flex items-center">
                  <i class="fas fa-hashtag mr-2 text-gray-400"></i>
                  Pedido #<%= order.id %>
                </h3>
                <p class="text-sm text-gray-500 flex items-center mt-1">
                  <i class="fas fa-calendar-alt mr-2 text-gray-400"></i>
                  <%= new Date(order.createdAt).toLocaleDateString('es-ES', { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                  }) %>
                </p>
              </div>
              
              <div class="mt-2 md:mt-0">
                <% 
                  let statusColor = 'gray';
                  let statusText = 'Desconocido';
                  let statusIcon = 'fa-question-circle';
                  
                  if (order.status === 'pending') {
                    statusColor = 'yellow';
                    statusText = 'Pendiente';
                    statusIcon = 'fa-clock';
                  } else if (order.status === 'completed') {
                    statusColor = 'green';
                    statusText = 'Completado';
                    statusIcon = 'fa-check-circle';
                  } else if (order.status === 'cancelled') {
                    statusColor = 'red';
                    statusText = 'Cancelado';
                    statusIcon = 'fa-times-circle';
                  }
                %>
                <span class="inline-flex items-center px-3 py-1 bg-<%= statusColor %>-100 text-<%= statusColor %>-800 rounded-full text-sm font-semibold">
                  <i class="fas <%= statusIcon %> mr-1"></i>
                  <%= statusText %>
                </span>
              </div>
            </div>
            
            <div class="border-t pt-4">
              <div class="flex items-center justify-between mb-4">
                <div>
                  <p class="text-sm text-gray-600 flex items-center">
                    <i class="fas fa-dollar-sign mr-1 text-gray-400"></i>
                    Total
                  </p>
                  <p class="text-2xl font-bold text-blue-600">$<%= parseFloat(order.total).toFixed(2) %></p>
                </div>
                
                <div class="text-right">
                  <p class="text-sm text-gray-600 flex items-center justify-end">
                    <i class="fas fa-box mr-1 text-gray-400"></i>
                    Productos
                  </p>
                  <p class="text-lg font-semibold text-gray-800">
                    <%= order.items.reduce((sum, item) => sum + item.quantity, 0) %> items
                  </p>
                </div>
              </div>
              
              <!-- Order Items Preview -->
              <div class="flex flex-wrap gap-2 mb-4">
                <% order.items.slice(0, 4).forEach(item => { %>
                  <% if (item.product && item.product.images && item.product.images.length > 0) { %>
                    <% const mainImage = item.product.images.find(img => img.isMain) || item.product.images[0]; %>
                    <img 
                      src="<%= mainImage.imageUrl %>" 
                      alt="<%= item.product.name %>" 
                      class="w-16 h-16 object-cover rounded border"
                      title="<%= item.product.name %>"
                    >
                  <% } else { %>
                    <div class="w-16 h-16 bg-gray-200 rounded border flex items-center justify-center">
                      <i class="fas fa-image text-gray-400"></i>
                    </div>
                  <% } %>
                <% }); %>
                <% if (order.items.length > 4) { %>
                  <div class="w-16 h-16 bg-gray-200 rounded border flex items-center justify-center">
                    <span class="text-gray-600 text-sm font-semibold">+<%= order.items.length - 4 %></span>
                  </div>
                <% } %>
              </div>
              
              <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                <p class="text-sm text-gray-600 flex items-start">
                  <i class="fas fa-map-marker-alt mr-2 text-red-500 mt-0.5"></i>
                  <span><strong>Envío:</strong> <%= order.shippingAddress %></span>
                </p>
                
                <a 
                  href="/client/orders/<%= order.id %>" 
                  class="inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm transition"
                >
                  <i class="fas fa-eye mr-2"></i>
                  Ver Detalle
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
    
    <div class="mt-8 text-center">
      <p class="text-gray-600 mb-4">
        <i class="fas fa-shopping-bag mr-2"></i>
        Tienes <%= orders.length %> pedido<%= orders.length !== 1 ? 's' : '' %> en total
      </p>
      <a href="/products" class="inline-flex items-center text-blue-600 hover:underline">
        Seguir comprando
        <i class="fas fa-arrow-right ml-2"></i>
      </a>
    </div>
  <% } %>
</div>

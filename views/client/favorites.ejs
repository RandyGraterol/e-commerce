<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-800 mb-8">Mis Favoritos</h1>
  
  <% if (favorites.length === 0) { %>
    <div class="bg-white rounded-lg shadow-md p-12 text-center">
      <div class="text-6xl mb-4 text-red-400">
        <i class="fas fa-heart"></i>
      </div>
      <h2 class="text-2xl font-semibold text-gray-800 mb-2">No tienes favoritos aún</h2>
      <p class="text-gray-600 mb-6">Explora nuestros productos y agrega tus favoritos</p>
      <a href="/products" class="inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition">
        <i class="fas fa-box mr-2"></i> Ver Productos
      </a>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">
      <% favorites.forEach(favorite => { %>
        <% const product = favorite.product; %>
        <% const mainImage = product.images.find(img => img.isMain) || product.images[0]; %>
        <div class="product-card group bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 flex flex-col relative">
          <!-- Remove Button -->
          <button 
            onclick="removeFavorite(<%= favorite.id %>, '<%= product.name %>')"
            class="absolute top-3 right-3 z-10 bg-white hover:bg-red-50 text-red-600 w-10 h-10 rounded-full shadow-lg flex items-center justify-center transition-all duration-200 hover:scale-110"
            title="Eliminar de favoritos"
          >
            <i class="fas fa-times text-lg"></i>
          </button>
          
          <!-- Image Container -->
          <div class="relative overflow-hidden bg-gray-100">
            <a href="/products/<%= product.id %>" class="block">
              <% if (mainImage) { %>
                <img 
                  src="<%= mainImage.imageUrl %>" 
                  alt="<%= product.name %>" 
                  class="w-full h-48 sm:h-56 object-cover group-hover:scale-110 transition-transform duration-500"
                >
              <% } else { %>
                <div class="w-full h-48 sm:h-56 bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center">
                  <i class="fas fa-image text-gray-400 text-4xl"></i>
                </div>
              <% } %>
            </a>
            
            <!-- Stock Badge -->
            <div class="absolute bottom-3 left-3">
              <% if (product.stock > 0) { %>
                <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-semibold shadow-md flex items-center">
                  <i class="fas fa-check-circle mr-1"></i> Stock: <%= product.stock %>
                </span>
              <% } else { %>
                <span class="bg-red-500 text-white px-3 py-1 rounded-full text-xs font-semibold shadow-md flex items-center">
                  <i class="fas fa-times-circle mr-1"></i> Agotado
                </span>
              <% } %>
            </div>
          </div>
          
          <!-- Content -->
          <div class="p-4 sm:p-5 flex flex-col flex-grow">
            <!-- Category -->
            <div class="flex items-center text-xs sm:text-sm text-gray-500 mb-2">
              <i class="fas fa-tag mr-1.5 text-blue-500"></i>
              <span class="truncate"><%= product.category.name %></span>
            </div>
            
            <!-- Title -->
            <a href="/products/<%= product.id %>" class="block mb-3">
              <h3 class="font-bold text-gray-800 text-base sm:text-lg leading-tight group-hover:text-blue-600 transition line-clamp-2 min-h-[2.5rem] sm:min-h-[3rem]">
                <%= product.name %>
              </h3>
            </a>
            
            <!-- Price -->
            <div class="mb-4 mt-auto">
              <div class="flex items-baseline gap-2">
                <span class="text-2xl sm:text-3xl font-bold text-blue-600">
                  $<%= parseFloat(product.price).toFixed(2) %>
                </span>
              </div>
              <p class="text-xs text-green-600 font-medium mt-1">
                <i class="fas fa-truck mr-1"></i> Envío gratis
              </p>
            </div>
            
            <!-- Actions -->
            <div class="flex gap-2">
              <% if (product.stock > 0) { %>
                <button 
                  onclick="quickAddToCart('<%= product.id %>')"
                  class="flex-1 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white px-3 sm:px-4 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-lg flex items-center justify-center"
                  title="Agregar al carrito"
                >
                  <i class="fas fa-cart-plus mr-1.5"></i>
                  <span class="hidden sm:inline">Agregar</span>
                  <span class="sm:hidden">+</span>
                </button>
              <% } %>
              
              <a 
                href="/products/<%= product.id %>" 
                class="<%= product.stock > 0 ? '' : 'flex-1' %> bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white px-3 sm:px-4 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-lg flex items-center justify-center"
              >
                <i class="fas fa-eye mr-1.5"></i>
                Ver Detalle
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
    
    <style>
      .product-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .product-card:hover {
        transform: translateY(-8px);
      }
      
      .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
    </style>
    
    <div class="mt-8 text-center">
      <p class="text-gray-600 mb-4">
        Tienes <%= favorites.length %> producto<%= favorites.length !== 1 ? 's' : '' %> en favoritos
      </p>
      <a href="/products" class="inline-block text-blue-600 hover:underline">
        <i class="fas fa-arrow-right mr-1"></i> Seguir explorando productos
      </a>
    </div>
  <% } %>
</div>

<script>
async function quickAddToCart(productId) {
  try {
    const response = await fetch('/cart/add', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ productId, quantity: 1 })
    });
    
    const data = await response.json();
    
    if (data.success) {
      const goToCart = await showConfirm(
        '¡Producto agregado!',
        'El producto se agregó correctamente al carrito. ¿Deseas ir al carrito ahora?',
        {
          confirmText: 'Ir al carrito',
          cancelText: 'Seguir comprando',
          type: 'success'
        }
      );
      
      if (goToCart) {
        window.location.href = '/cart';
      } else {
        showSuccess('Producto agregado al carrito');
      }
    } else {
      showError(data.error || 'Error al agregar al carrito');
    }
  } catch (error) {
    console.error('Error:', error);
    showError('Error al agregar al carrito');
  }
}

async function removeFavorite(favoriteId, productName) {
  const shouldRemove = await showConfirm(
    'Eliminar de favoritos',
    `¿Estás seguro de eliminar "${productName}" de tus favoritos?`,
    {
      confirmText: 'Eliminar',
      cancelText: 'Cancelar',
      type: 'warning'
    }
  );
  
  if (!shouldRemove) {
    return;
  }
  
  try {
    showLoading('Eliminando de favoritos...');
    
    const response = await fetch(`/client/favorites/${favoriteId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json'
      }
    });
    
    const data = await response.json();
    
    hideLoading();
    
    if (data.success) {
      showSuccess('Producto eliminado de favoritos');
      setTimeout(() => window.location.reload(), 800);
    } else {
      showError(data.error || 'Error al eliminar de favoritos');
    }
  } catch (error) {
    hideLoading();
    console.error('Error:', error);
    showError('Error al eliminar de favoritos');
  }
}
</script>

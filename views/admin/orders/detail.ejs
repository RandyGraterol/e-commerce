<div class="container mx-auto px-4 py-8 max-w-5xl">
  <div class="mb-6">
    <a href="/admin/orders" class="text-blue-600 hover:underline">&larr; Volver a órdenes</a>
  </div>

  <div class="bg-white rounded-lg shadow-md p-8">
    <!-- Order Header -->
    <div class="flex justify-between items-start mb-6 pb-6 border-b">
      <div>
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Orden #<%= order.id %></h1>
        <p class="text-gray-600">
          Fecha: <%= new Date(order.createdAt).toLocaleDateString('es-ES', { 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          }) %>
        </p>
      </div>
      
      <div class="text-right">
        <% 
          let statusClass = 'bg-yellow-100 text-yellow-800';
          let statusText = 'Pendiente';
          if (order.status === 'completed') {
            statusClass = 'bg-green-100 text-green-800';
            statusText = 'Completada';
          } else if (order.status === 'cancelled') {
            statusClass = 'bg-red-100 text-red-800';
            statusText = 'Cancelada';
          }
        %>
        <span class="inline-block px-4 py-2 text-sm font-medium <%= statusClass %> rounded-lg">
          <%= statusText %>
        </span>
        
        <% if (order.status === 'pending') { %>
          <div class="mt-4 space-x-2">
            <button 
              onclick="updateStatus(<%= order.id %>, 'completed')" 
              class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm rounded-lg transition"
            >
              Marcar como Completada
            </button>
            <button 
              onclick="updateStatus(<%= order.id %>, 'cancelled')" 
              class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm rounded-lg transition"
            >
              Cancelar Orden
            </button>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Customer Information -->
    <div class="mb-6 pb-6 border-b">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Información del Cliente</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <p class="text-sm text-gray-600">Nombre</p>
          <p class="text-gray-900 font-medium"><%= order.user.name %></p>
        </div>
        <div>
          <p class="text-sm text-gray-600">Email</p>
          <p class="text-gray-900 font-medium"><%= order.user.email %></p>
        </div>
      </div>
    </div>

    <!-- Shipping Information -->
    <% if (order.shippingAddress) { %>
      <div class="mb-6 pb-6 border-b">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Dirección de Envío</h2>
        <p class="text-gray-900 whitespace-pre-line"><%= order.shippingAddress %></p>
      </div>
    <% } %>

    <!-- Payment Information -->
    <div class="mb-6 pb-6 border-b">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Información de Pago</h2>
      <p class="text-sm text-gray-600">Método de Pago</p>
      <p class="text-gray-900 font-medium"><%= order.paymentMethod %></p>
    </div>

    <!-- Order Items -->
    <div class="mb-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Productos</h2>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Producto</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Precio</th>
              <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Cantidad</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Subtotal</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% order.items.forEach(item => { %>
              <tr>
                <td class="px-4 py-4">
                  <div class="text-sm font-medium text-gray-900"><%= item.product.name %></div>
                  <div class="text-sm text-gray-500">ID: <%= item.product.id %></div>
                </td>
                <td class="px-4 py-4 text-right text-sm text-gray-900">
                  $<%= parseFloat(item.price).toFixed(2) %>
                </td>
                <td class="px-4 py-4 text-center text-sm text-gray-900">
                  <%= item.quantity %>
                </td>
                <td class="px-4 py-4 text-right text-sm font-medium text-gray-900">
                  $<%= (parseFloat(item.price) * item.quantity).toFixed(2) %>
                </td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot class="bg-gray-50 border-t-2 border-gray-300">
            <tr>
              <td colspan="3" class="px-4 py-4 text-right text-base font-semibold text-gray-900">
                Total:
              </td>
              <td class="px-4 py-4 text-right text-lg font-bold text-gray-900">
                $<%= parseFloat(order.total).toFixed(2) %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex justify-end space-x-4 pt-6 border-t">
      <a 
        href="/admin/orders" 
        class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition"
      >
        Volver a la Lista
      </a>
    </div>
  </div>
</div>

<script>
async function updateStatus(orderId, newStatus) {
  const statusText = newStatus === 'completed' ? 'completar' : 'cancelar';
  
  if (!confirm(`¿Estás seguro de ${statusText} esta orden?`)) {
    return;
  }
  
  try {
    const response = await fetch(`/admin/orders/${orderId}/status`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ status: newStatus })
    });
    
    const data = await response.json();
    
    if (data.success) {
      alert(data.message);
      window.location.reload();
    } else {
      alert(data.error || 'Error al actualizar el estado');
    }
  } catch (error) {
    console.error('Error:', error);
    alert('Error al actualizar el estado de la orden');
  }
}
</script>

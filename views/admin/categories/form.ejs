<div class="max-w-2xl">
  <div class="flex items-center mb-6">
    <a href="/admin/categories" class="text-gray-600 hover:text-gray-900 mr-4">
      ← Volver
    </a>
    <h1 class="text-2xl font-bold text-gray-800">
      <%= category ? 'Editar Categoría' : 'Nueva Categoría' %>
    </h1>
  </div>

  <% if (error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-6" role="alert">
      <span class="block sm:inline"><%= error %></span>
    </div>
  <% } %>

  <div class="bg-white rounded-lg shadow-md p-6">
    <form action="<%= category ? `/admin/categories/${category.id}` : '/admin/categories' %>" method="POST">
      <div class="mb-4">
        <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
          Nombre <span class="text-red-500">*</span>
        </label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          value="<%= category ? category.name : '' %>"
          required
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="Ej: Electrónica"
        >
      </div>

      <div class="mb-6">
        <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
          Descripción
        </label>
        <textarea 
          id="description" 
          name="description" 
          rows="4"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="Descripción de la categoría"
        ><%= category ? (category.description || '') : '' %></textarea>
      </div>

      <div class="flex justify-end space-x-4">
        <a href="/admin/categories" class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition">
          Cancelar
        </a>
        <button 
          type="submit" 
          class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition"
        >
          <%= category ? 'Actualizar' : 'Crear' %> Categoría
        </button>
      </div>
    </form>
  </div>
</div>
